import {spawnSync} from "node:child_process";
import {randomUUID} from "node:crypto";
const py=String.raw`import sys,json,sqlite3,uuid,datetime,re
x=json.load(sys.stdin)
db=x["database"]
con=sqlite3.connect(db,timeout=10)
con.execute("PRAGMA busy_timeout=10000")
con.execute("CREATE TABLE IF NOT EXISTS source_inspections_v1 (id TEXT PRIMARY KEY, plan_id TEXT NOT NULL, task_id TEXT NOT NULL, source_url TEXT NOT NULL, content_sha256 TEXT NOT NULL, inspection_json TEXT NOT NULL, created_utc TEXT NOT NULL)")
plan=con.execute("SELECT plan_json FROM plans WHERE id=?",(x["plan_id"],)).fetchone()
if plan is None: raise ValueError("SOURCE_PLAN_NOT_FOUND")
p=json.loads(plan[0])
tasks=p.get("tasks",[])
if not any(t.get("task_id")==x["task_id"] or t.get("id")==x["task_id"] for t in tasks): raise ValueError("SOURCE_TASK_NOT_FOUND")
r=x["inspection"]
if r.get("state")!="retrieved_unverified" or r.get("score_eligible") is not False or r.get("verification_status")!="source_retrieved_claims_unverified": raise ValueError("SOURCE_VERIFICATION_BOUNDARY")
if not re.fullmatch("[0-9a-f]{64}",r.get("content_sha256","")): raise ValueError("SOURCE_HASH_INVALID")
if not isinstance(r.get("source_url"),str) or not r["source_url"].startswith(("https://","http://")): raise ValueError("SOURCE_URL_INVALID")
if not isinstance(r.get("bytes"),int) or r["bytes"]<0 or r["bytes"]>262144: raise ValueError("SOURCE_BYTES_INVALID")
if not isinstance(r.get("retrieved_utc"),str) or not r["retrieved_utc"]: raise ValueError("SOURCE_TIMESTAMP_INVALID")
if r.get("external_actions")!=1: raise ValueError("SOURCE_RETRIEVAL_METADATA_INVALID")
i=str(uuid.uuid4())
created=datetime.datetime.now(datetime.timezone.utc).isoformat()
con.execute("INSERT INTO source_inspections_v1 VALUES (?,?,?,?,?,?,?)",(i,x["plan_id"],x["task_id"],r["source_url"],r["content_sha256"],json.dumps(r,sort_keys=True),created))
con.commit()
print(json.dumps({"id":i,"plan_id":x["plan_id"],"task_id":x["task_id"],"content_sha256":r["content_sha256"],"verification_status":r["verification_status"],"score_eligible":False,"external_actions_executed_by_storage":0}))
con.close()`;
export function persistSourceInspection({database,python,plan_id,task_id,inspection}){
if(!database||!python||!plan_id||!task_id||!inspection)throw Error("SOURCE_STORAGE_INPUT_INVALID");
const p=spawnSync(python,["-c",py],{input:JSON.stringify({database,plan_id,task_id,inspection}),encoding:"utf8",timeout:15000,maxBuffer:1048576});
if(p.status!==0)throw Error("SOURCE_STORAGE_HOLD: "+String(p.stderr||p.error||"unknown").slice(0,1200));
return JSON.parse(p.stdout)}
