# Local control plane
HOST=127.0.0.1
PORT=8787

# Optional adapters; disabled by default
REA_ENABLED=false
REA_COMMAND=rea
REA_ARGS=mcp

# NetBird must be installed and enrolled separately.
NETBIRD_ENABLED=false
NETBIRD_COMMAND=netbird
# Set true only if Start platform should also issue netbird up.
NETBIRD_AUTOCONNECT=false
